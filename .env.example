PORT=3000
SESSION_SECRET=qcasa-cambiar-esta-clave
USE_MONGO=false
MONGO_URI=
# Protección: la semilla solo corre si esto se habilita explícitamente.
ALLOW_MONGO_SEED=false
# Mantener false. Solo existe como salvaguarda adicional para evitar sembrar una base real.
ALLOW_NONTEST_SEED=false
BASE_URL=http://localhost:3000
NODE_ENV=development

# Etapa 5 · comercial
DEMO_MODE=true
# Email opcional. Si queda vacío, las consultas se guardan igual y no se envía correo.
QCASA_NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

{% extends 'layouts/main.njk' %}

{% block content %}
<section class="scanner-shell">
  <div class="scanner-topbar">
    <a href="/" class="scanner-back">← Volver</a>
    <img src="/img/logo-qcasa.svg" alt="QCASA">
    <span></span>
  </div>

  <div class="scanner-card">
    <span class="eyebrow">RECLAMOS QCASA</span>
    <h1>Escaneá el QR de tu propiedad</h1>
    <p class="muted">
      El QR identifica automáticamente la propiedad y la unidad.
      No necesitás ingresar dirección ni datos del propietario.
    </p>

    <div class="scanner-video-wrap" id="scannerVideoWrap">
      <video id="qrVideo" playsinline muted></video>
      <div class="scanner-frame" aria-hidden="true">
        <i></i><i></i><i></i><i></i>
      </div>
      <div class="scanner-placeholder" id="scannerPlaceholder">
        <div class="scanner-placeholder-icon">▦</div>
        <strong>Cámara detenida</strong>
        <small>Presioná el botón para comenzar</small>
      </div>
    </div>

    <div id="scannerMessage" class="scanner-message" role="status">
      Tocá “Abrir cámara” y apuntá al QR.
    </div>

    <button type="button" class="btn btn-primary btn-lg scanner-main-btn" id="startScanner">
      📷 Abrir cámara
    </button>

    <label class="btn btn-light btn-lg scanner-photo-btn" for="qrPhoto">
      📸 Tomar foto del QR
    </label>
    <input
      id="qrPhoto"
      class="scanner-file-input"
      type="file"
      accept="image/*"
      capture="environment"
    >

    <div class="scanner-divider"><span>o</span></div>

    <div id="codigo" class="manual-code">
      <h2>Ingresar código manualmente</h2>
      <p class="muted">Ejemplo: <strong>AB123X</strong></p>

      <form id="manualCodeForm">
        <label for="propertyCode">Código QCASA</label>
        <div class="manual-code-row">
          <input
            id="propertyCode"
            name="propertyCode"
            type="text"
            placeholder="AB123X"
            maxlength="30"
            autocomplete="off"
            required
          >
          <button class="btn btn-primary" type="submit">Continuar</button>
        </div>
      </form>
    </div>

    <div class="scanner-help">
      <strong>¿Qué pasa después?</strong>
      <p>
        Al detectar el QR te llevamos directamente al formulario de esa propiedad
        para que indiques el problema y envíes el reclamo.
      </p>
    </div>
  </div>
</section>

<script src="/js/qr-scanner.js"></script>
{% endblock %}

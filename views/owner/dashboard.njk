{% extends 'layouts/owner.njk' %}{% block content %}<div class="page-head"><div><span class="eyebrow">PROPIETARIO</span><h1>Mis propiedades</h1><p class="muted">Estado general de inmuebles, reclamos, documentos y vencimientos.</p></div></div><div class="property-grid">{% for p in properties %}<article class="property-card"><img src="{{ p.coverPhoto }}" alt="Propiedad"><div class="property-card-body"><span class="badge">{{ p.type }}</span><h2>{{ p.address }}</h2><p>{{ p.unit }}</p><a href="/propietario/propiedades/{{ p.code }}" class="btn btn-dark btn-block">Ver propiedad</a></div></article>{% endfor %}</div><section class="panel"><h2>Reclamos</h2><div class="data-table">{% for c in complaints %}<div><span>#{{ c.number }}</span><strong>{{ c.title }}</strong><span>{{ c.propertyCode }}</span><span class="badge">{{ c.status }}</span></div>{% else %}<p>Sin reclamos.</p>{% endfor %}</div></section><section class="panel"><h2>Próximos vencimientos</h2><div class="attention-list">{% for a in alerts %}<div class="attention-item"><span class="dot dot-{{ a.level }}"></span><div><strong>{{ a.title }}</strong><span>{{ a.propertyCode }}</span></div><small>{{ a.statusText }}</small></div>{% endfor %}</div></section><section class="panel"><h2>Documentos</h2><div class="data-table">{% for d in documents %}<div><span>{{ d.propertyCode }}</span><strong>{{ d.title }}</strong><span>{{ d.type }}</span></div>{% endfor %}</div></section>{% endblock %}

{% extends 'layouts/owner.njk' %}
{% block content %}
<section class="owner-detail-shell">
  <a href="/propietario#reclamos" class="owner-back">← Volver a reclamos</a>

  <div class="owner-detail-header">
    <div>
      <span class="eyebrow">RECLAMO #{{ complaint.number or complaint.id }}</span>
      <h1>{{ complaint.title or complaint.category }}</h1>
      <p class="muted">{{ property.address }} · {{ property.unit }}</p>
    </div>

    <div class="owner-detail-badges">
      {% if complaint.priority == 'urgent' %}
        <span class="owner-badge urgent">Urgente</span>
      {% endif %}
      <span class="owner-badge">{{ complaint.status }}</span>
    </div>
  </div>

  <div class="owner-detail-grid">
    <section class="panel">
      <h2>Problema reportado</h2>
      <dl class="owner-detail-list">
        <div><dt>Categoría</dt><dd>{{ complaint.category }}</dd></div>
        <div><dt>Descripción</dt><dd>{{ complaint.description }}</dd></div>
        <div><dt>Contacto</dt><dd>{{ complaint.phone or property.tenant.phone or '—' }}</dd></div>
        <div><dt>Archivos</dt><dd>{{ complaint.files or 0 }}</dd></div>
      </dl>
    </section>

    <section class="panel">
      <h2>Servicio</h2>
      <dl class="owner-detail-list">
        <div><dt>Estado</dt><dd>{{ complaint.status }}</dd></div>
        <div><dt>Técnico</dt><dd>{{ complaint.technician or 'Sin asignar' }}</dd></div>
        <div><dt>Prioridad</dt><dd>{{ complaint.priority }}</dd></div>
      </dl>
    </section>
  </div>

  <section class="panel invoice-panel">
    <div class="panel-title">
      <div>
        <h2>Facturas y comprobantes</h2>
        <span class="muted">Documentación asociada específicamente a este reclamo.</span>
      </div>
    </div>

    {% if complaint.invoices and complaint.invoices|length %}
      <div class="invoice-list">
        {% for invoice in complaint.invoices %}
        <article>
          <div>
            <strong>{{ invoice.number }}</strong>
            <span>{{ invoice.concept }}</span>
            <small>{{ invoice.date }}</small>
          </div>
          <div class="invoice-amount">
            {{ invoice.currency }} {{ invoice.amount }}
          </div>
          {% if invoice.url and invoice.url != '#' %}
            <a href="{{ invoice.url }}" target="_blank" class="btn btn-light">Ver factura</a>
          {% else %}
            <span class="invoice-demo">Demo</span>
          {% endif %}
        </article>
        {% endfor %}
      </div>
    {% else %}
      <div class="empty-filter">
        <strong>Todavía no hay facturas para este reclamo.</strong>
        <p>Cuando administración cargue una factura o comprobante aparecerá acá.</p>
      </div>
    {% endif %}
  </section>
</section>
{% endblock %}

{% extends 'layouts/owner.njk' %}
{% block content %}
<section class="owner-form-shell">
  <div class="owner-form-head">
    <a href="/propietario#propiedades">← Volver a mis propiedades</a>
    <span class="eyebrow">PROPIETARIO</span>
    <h1>{% if mode == 'create' %}Nueva propiedad{% else %}Editar propiedad{% endif %}</h1>
    <p class="muted">Guardá solamente la información necesaria para identificar la vivienda y al inquilino.</p>
  </div>

  {% if error %}<div class="owner-alert error">{{ error }}</div>{% endif %}
  {% if success %}<div class="owner-alert success">{{ success }}</div>{% endif %}

  <form class="owner-form-card" method="post">
    {% if mode == 'edit' %}
      <div class="property-code-box">
        <div>
          <small>CÓDIGO QCASA</small>
          <strong>{{ property.code }}</strong>
        </div>
        <a href="/r/{{ property.code }}" class="btn btn-light">Probar QR</a>
      </div>
    {% endif %}

    <h2>Datos de la propiedad</h2>

    <div class="form-grid">
      <label class="span-2">
        Dirección *
        <input type="text" name="address" required value="{{ property.address or '' }}" placeholder="Av. Brasil 1234">
      </label>

      <label>
        Unidad / Apto
        <input type="text" name="unit" value="{{ property.unit or '' }}" placeholder="302">
      </label>

      <label>
        Tipo
        <select name="type">
          {% for t in ['Apartamento','Casa','Local','Oficina','Otro'] %}
            <option value="{{ t }}" {% if property.type == t %}selected{% endif %}>{{ t }}</option>
          {% endfor %}
        </select>
      </label>

      <label>
        Ciudad
        <input type="text" name="city" value="{{ property.city or '' }}" placeholder="Montevideo">
      </label>

      <label>
        Departamento
        <input type="text" name="department" value="{{ property.department or '' }}" placeholder="Montevideo">
      </label>

      <label>
        Dormitorios
        <input type="number" min="0" name="bedrooms" value="{{ property.bedrooms or 0 }}">
      </label>
    </div>

    <h2>Inquilino</h2>

    <div class="form-grid">
      <label>
        Nombre
        <input type="text" name="tenantName" value="{{ property.tenant.name or property.tenantName or '' }}">
      </label>

      <label>
        Teléfono
        <input type="tel" name="tenantPhone" value="{{ property.tenant.phone or property.tenantPhone or '' }}">
      </label>

      <label class="span-2">
        Email
        <input type="email" name="tenantEmail" value="{{ property.tenant.email or property.tenantEmail or '' }}">
      </label>

      <label class="span-2">
        Notas
        <textarea name="notes" rows="4" placeholder="Información útil sobre la propiedad...">{{ property.notes or '' }}</textarea>
      </label>
    </div>

    <div class="owner-form-actions">
      <a href="/propietario#propiedades" class="btn btn-light">Cancelar</a>
      <button type="submit" class="btn btn-primary">
        {% if mode == 'create' %}Crear propiedad{% else %}Guardar cambios{% endif %}
      </button>
    </div>
  </form>
</section>
{% endblock %}

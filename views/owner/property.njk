{% extends 'layouts/owner.njk' %}{% block content %}<div class="page-head"><div><span class="eyebrow">{{ property.code }}</span><h1>{{ property.address }}{% if property.unit %} · {{ property.unit }}{% endif %}</h1></div></div><div class="property-hero"><img src="{{ property.coverPhoto }}"><div><h2>{{ property.type }}</h2><p>{{ property.notes }}</p></div></div><section class="panel"><h2>Alquiler</h2><div class="detail-grid"><div><span>Importe</span><strong>{{ money(property.lease.amount,property.lease.currency) }}</strong></div><div><span>Vencimiento</span><strong>{{ property.lease.endDate }}</strong></div><div><span>Garantía</span><strong>{{ property.lease.guaranteeType }}</strong></div><div><span>Estado</span><strong>{{ property.lease.status }}</strong></div></div></section><section class="panel"><h2>Estado / alertas</h2><div class="attention-list">{% for a in alerts %}<div class="attention-item"><span class="dot dot-{{ a.level }}"></span><div><strong>{{ a.title }}</strong><span>{{ a.type }}</span></div><small>{{ a.statusText }}</small></div>{% endfor %}</div></section><section class="panel"><h2>Reclamos</h2><div class="data-table">{% for c in complaints %}<div><span>#{{ c.number }}</span><strong>{{ c.title }}</strong><span>{{ c.status }}</span></div>{% else %}<p>Sin reclamos.</p>{% endfor %}</div></section><section class="panel"><h2>Documentos</h2><div class="data-table">{% for d in documents %}<div><span>{{ d.type }}</span><strong>{{ d.title }}</strong><span>{{ d.dueDate or 'Sin vencimiento' }}</span></div>{% endfor %}</div></section>{% endblock %}

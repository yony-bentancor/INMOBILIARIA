{% extends "layouts/main.njk" %}

{% block content %}

  <!-- =====================================================
     HERO
===================================================== -->

  <section class="home-hero">

    <div class="container home-hero-grid">

      <!-- TEXTO -->
      <div class="home-hero-content">

        <span class="home-eyebrow">
        ENCONTRÁ TU LUGAR
      </span>

        <h1>
        UN APARTAMENTO,<br>
        UNA CASA, UN CAMPO,<br>
        UN <span>HOGAR</span>
        </h1>

        <p>
        Casas, apartamentos, chacras y campos<br>
        en un solo lugar.
      </p>

      </div>

      <!-- IMAGEN -->
      <div class="home-hero-image">

        <img
        src="/img/placeholder1.jpg"
        alt="Propiedades en Mercado Casas"
      >

      </div>

    </div>

    <!-- ===================================================
       BUSCADOR
  ==================================================== -->

    <div class="container">

      <form
      action="/buscar"
      method="GET"
      class="property-search"
    >

        <!-- OPERACIÓN -->

        <div class="property-search-field">

          <label>Quiero</label>

          <select name="operacion">
            <option value="comprar">Comprar</option>
            <option value="alquilar">Alquilar</option>
          </select>

        </div>

        <!-- TIPO -->

        <div class="property-search-field">

          <label>Tipo de propiedad</label>

          <select name="tipo">

            <option value="">Todas</option>

            <option value="casa">
            Casa
          </option>

            <option value="apartamento">
            Apartamento
          </option>

            <option value="chacra">
            Chacra
          </option>

            <option value="campo">
            Campo
          </option>

          </select>

        </div>

        <!-- DEPARTAMENTO -->

        <div class="property-search-field">

          <label>Departamento</label>

          <select name="departamento">

            <option value="">
            Todos los departamentos (19)
          </option>

            <option value="artigas">Artigas</option>
            <option value="canelones">Canelones</option>
            <option value="cerro-largo">Cerro Largo</option>
            <option value="colonia">Colonia</option>
            <option value="durazno">Durazno</option>
            <option value="flores">Flores</option>
            <option value="florida">Florida</option>
            <option value="lavalleja">Lavalleja</option>
            <option value="maldonado">Maldonado</option>
            <option value="montevideo">Montevideo</option>
            <option value="paysandu">Paysandú</option>
            <option value="rio-negro">Río Negro</option>
            <option value="rivera">Rivera</option>
            <option value="rocha">Rocha</option>
            <option value="salto">Salto</option>
            <option value="san-jose">San José</option>
            <option value="soriano">Soriano</option>
            <option value="tacuarembo">Tacuarembó</option>
            <option value="treinta-y-tres">Treinta y Tres</option>

          </select>

        </div>

        <!-- PALABRA CLAVE -->

        <div class="property-search-field property-search-keyword">

          <label>Palabra clave</label>

          <input
          type="text"
          name="q"
          placeholder="Ej: Pocitos, piscina, vista al mar..."
        >

        </div>

        <!-- BUSCAR -->

        <button
        type="submit"
        class="property-search-button"
        aria-label="Buscar propiedades"
      >
          <span class="search-icon"></span>
        </button>

      </form>

    </div>

  </section>

  <!-- =====================================================
     BENEFICIOS
===================================================== -->

  <section class="home-benefits">

    <div class="container benefits-grid">

      <div class="benefit">

        <div class="benefit-icon">
        ✓
      </div>

        <div>
          <strong>Propiedades verificadas</strong>
          <span>Publicaciones reales y confiables.</span>
        </div>

      </div>

      <div class="benefit">

        <div class="benefit-icon">
        ♡
      </div>

        <div>
          <strong>Atención personalizada</strong>
          <span>Te ayudamos cuando lo necesites.</span>
        </div>

      </div>

      <div class="benefit">

        <div class="benefit-icon">
        🔒
      </div>

        <div>
          <strong>Transacciones seguras</strong>
          <span>Tu seguridad es nuestra prioridad.</span>
        </div>

      </div>

    </div>

  </section>

{% endblock %}
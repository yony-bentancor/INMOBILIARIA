{% extends "layouts/main.njk" %}

{% block content %}
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">NUESTRA FILOSOFIA</span>
        {# <h1>Una base solida para construir tus proyectos sin arrancar de cero.</h1> #}
        <h2>UN APARTAMENTO, UNA CASA, UN CAMPO, UN HOGAR</h2>

        <p class="hero-text">
          {#  Usuarios, administrador, MongoDB Atlas, sesiones, CRUD genérico,
        Nunjucks, CSS responsive y estructura lista para Git y Heroku. #}
        </p>

        <div class="hero-actions">
          <a class="btn btn-primary" href="/items">Ver ejemplo CRUD</a>
          {% if not currentUser %}
            <a class="btn btn-secondary" href="/auth/register">Crear usuario</a>
          {% else %}
            <a class="btn btn-secondary" href="/dashboard">Ir a mi panel</a>
          {% endif %}
        </div>
      </div>

      <div class="hero-card">
        <img src="/img/placeholder1.jpg" alt="Imagen de ejemplo">
        <div>
          <span class="eyebrow">ACCESO</span>
          <h4>Iniciar sesión</h4>
          <p>Ingresá con tu usuario normal o administrador.</p>

          <form action="/auth/login" method="POST" class="form-stack">
            <label>
          Email
          <input type="email" name="email" required autocomplete="email">
            </label>

            <label>
          Contraseña
          <input type="password" name="password" required autocomplete="current-password">
            </label>

            <button class="btn btn-primary btn-full" type="submit">Ingresar</button>
          </form>

          <p class="form-note">
        ¿No tenés cuenta? <a href="/auth/register">Registrate</a>.
      </p>
          {# <span class="badge">Busca lo que precisas</span> #}
          {#    <h2>Casas/Apartamentos Chacras/Campo</h2>
          <p>
            <span class="badge"> Estas buscando cambiar tu futuro ?</span>
            <code>Bienvenido</code> Podemos ayudarte!!
        </p> #}
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">INCLUIDO</span>
        <h2>Lo básico ya resuelto</h2>
      </div>

      <div class="feature-grid">

        <article class="feature-card">
          <div class="feature-icon">📋</div>
          <h3>ADMINISTRACIÓN</h3>
          <p>Delegá la gestión de tu alquiler y nosotros nos ocupamos por vos.</p>
        </article>

        <article class="feature-card">
          <div class="feature-icon">🧹</div>
          <h3>LIMPIEZA</h3>
          <p>Contratá la limpieza de tu propiedad cuando la necesites.</p>
        </article>

        <article class="feature-card">
          <div class="feature-icon">🛡️</div>
          <h3>SEGURIDAD</h3>
          <p>Sumá protección y tranquilidad a tu propiedad durante el alquiler.</p>
        </article>

        <article class="feature-card">
          <div class="feature-icon">⚙️</div>
          <h3>SISTEMA DE GESTIÓN</h3>
          <p>Administrá reservas, disponibilidad y pagos desde un solo lugar.</p>
        </article>

      </div>
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <div class="section-heading row-between">
      <div>
        <span class="eyebrow">EJEMPLOS</span>
        <h2>Últimos elementos</h2>
      </div>
      <a href="/items">Ver todos →</a>
    </div>

    {% if latestItems.length %}
      <div class="item-grid">
        {% for item in latestItems %}
          <article class="item-card">
            <img
              src="{{ item.imageUrl or '/img/placeholder.svg' }}"
              alt="{{ item.title }}"
            >
            <div class="item-card-body">
              <span class="badge">{{ item.kind }}</span>
              <h3>{{ item.title }}</h3>
              <p>{{ item.description or "Sin descripción" }}</p>
              {% if item.price %}
                <strong class="price">$ {{ item.price }}</strong>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <div class="empty-state">
        <h3>Todavía no hay elementos cargados.</h3>
        <p>Conectá MongoDB Atlas y agregá el primero desde el ejemplo CRUD.</p>
      </div>
    {% endif %}
  </div>
</section>
{% endblock %}
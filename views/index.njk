{% extends "layouts/main.njk" %}

{% block content %}
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">NUESTRA FILOSOFIA</span>
        {# <h1>Una base solida para construir tus proyectos sin arrancar de cero.</h1> #}
        <h2>UN APARTAMENTO, UNA CASA, UN CAMPO, UN HOGAR</h2>

        <p class="hero-text">
          {#  Usuarios, administrador, MongoDB Atlas, sesiones, CRUD genérico,
        Nunjucks, CSS responsive y estructura lista para Git y Heroku. #}
        </p>

        <div class="hero-actions">
          <a class="btn btn-primary" href="/items">Ver ejemplo CRUD</a>
          {% if not currentUser %}
            <a class="btn btn-secondary" href="/auth/register">Crear usuario</a>
          {% else %}
            <a class="btn btn-secondary" href="/dashboard">Ir a mi panel</a>
          {% endif %}
        </div>
      </div>

      <div class="hero-card">
        <img src="/img/placeholder1.jpg" alt="Imagen de ejemplo">
        <div>
          {# <span class="badge">Busca lo que precisas</span> #}
          {#   <h2>Casas</h2>
          <p>
            <span class="badge"> Estas buscando cambiar tu hogar ?</span>
            <code>Bienvenido</code> Podemos ayudarte!!
        </p> #}

        </div>
      </div>

    </div>
  </section>

  <!-- BUSCADOR -->
  <form action="/buscar" method="GET" class="property-search">

    <!-- OPERACIÓN -->
    <div class="property-search-field">
      <label>Quiero</label>
      <select name="operacion">
        <option value="comprar">Comprar</option>
        <option value="alquilar">Alquilar</option>
      </select>
    </div>

    <!-- TIPO -->
    <div class="property-search-field">
      <label>Tipo de propiedad</label>
      <select name="tipo">
        <option value="">Todas</option>
        <option value="casa">Casa</option>
        <option value="apartamento">Apartamento</option>
        <option value="chacra">Chacra</option>
        <option value="campo">Campo</option>
      </select>
    </div>

    <!-- DEPARTAMENTO -->
    <div class="property-search-field property-search-depto">
      <label>Departamento</label>
      <select name="departamento">
        <option value="">Todos los departamentos (19)</option>
        <option value="artigas">Artigas</option>
        <option value="canelones">Canelones</option>
        <option value="cerro-largo">Cerro Largo</option>
        <option value="colonia">Colonia</option>
        <option value="durazno">Durazno</option>
        <option value="flores">Flores</option>
        <option value="florida">Florida</option>
        <option value="lavalleja">Lavalleja</option>
        <option value="maldonado">Maldonado</option>
        <option value="montevideo">Montevideo</option>
        <option value="paysandu">Paysandú</option>
        <option value="rio-negro">Río Negro</option>
        <option value="rivera">Rivera</option>
        <option value="rocha">Rocha</option>
        <option value="salto">Salto</option>
        <option value="san-jose">San José</option>
        <option value="soriano">Soriano</option>
        <option value="tacuarembo">Tacuarembó</option>
        <option value="treinta-y-tres">Treinta y Tres</option>
      </select>
    </div>

    <!-- PALABRA CLAVE -->
    <div class="property-search-field property-search-keyword">
      <label>Palabra clave</label>
      <input
        type="text"
        name="q"
        placeholder="Ej: Pocitos, piscina, vista al mar..."
      >
    </div>

    <!-- LUPA -->
    <button type="submit" class="property-search-button" aria-label="Buscar">
      &#128269;
    </button>

  </form>
</div>

{# <section class="section">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">INCLUIDO</span>
        <h2>Lo básico ya resuelto</h2>
      </div>

      <div class="feature-grid">

        <article class="feature-card">
          <div class="feature-icon">📋</div>
          <h3>ADMINISTRACIÓN</h3>
          <p>Delegá la gestión de tu alquiler y nosotros nos ocupamos por vos.</p>

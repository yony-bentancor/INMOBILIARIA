{% extends 'layouts/main.njk' %}
{% block content %}
<section class="hero">
  <div class="hero-copy">
    <div class="dot-pattern"></div>
    <h1>Tu hogar, un QR.<br><span>Todo resuelto.</span></h1>
    <p>La forma más rápida y simple de reportar problemas en tu propiedad.</p>
    <div class="hero-actions">
      <a class="btn btn-primary btn-lg" href="/r/AB123X">▦ Reportar un problema</a>
      <a class="btn btn-light btn-lg" href="/propiedades">⌂ Ver propiedades</a>
    </div>
    <div class="hero-benefits">
      <span>◉ Sin apps</span><span>◷ Respuesta rápida</span><span>✓ Seguimiento en tiempo real</span>
    </div>
  </div>
  <div class="hero-photo" aria-label="Interior de una propiedad"></div>
  <div class="hero-qr-side">
    <div class="qr-sticker">
      <img class="sticker-logo" src="/img/logo-qcasa.svg" alt="QCASA">
      <h3>¿Algo no funciona?</h3>
      <p>Escaneá y reportalo.</p>
      <img class="qr-demo" src="/img/qr-demo.svg" alt="QR de ejemplo">
      <div class="sticker-bottom">▯ &nbsp; Sin app. Sin llamadas.<br><strong>Lo resolvemos.</strong></div>
    </div>
  </div>
</section>

<section class="steps-strip">
  <article><div class="step-icon">▦</div><div><h3>Escaneá</h3><p>Encontrá el código QR único de tu propiedad.</p></div></article>
  <article><div class="step-icon">📝</div><div><h3>Reportá</h3><p>Contanos el problema en pocos pasos.</p></div></article>
  <article><div class="step-icon">🔔</div><div><h3>Seguimiento</h3><p>Recibí actualizaciones del estado.</p></div></article>
  <article><div class="step-icon">✓</div><div><h3>Resuelto</h3><p>Nos encargamos para que vuelvas a disfrutar tu hogar.</p></div></article>
</section>

<section class="how section">
  <h2>¿Cómo funciona?</h2>
  <div class="gold-line"></div>
  <div class="how-grid">
    <article><b>1</b><div class="big-icon">▦</div><h3>Escaneá el QR</h3><p>Encontrás el código en tu propiedad.</p></article>
    <article><b>2</b><div class="big-icon">▤</div><h3>Reportá el problema</h3><p>Elegí el tipo de problema y agregá fotos si querés.</p></article>
    <article><b>3</b><div class="big-icon">◌</div><h3>Recibí confirmación</h3><p>Te avisamos que recibimos tu reporte.</p></article>
    <article><b>4</b><div class="big-icon">✓</div><h3>Lo solucionamos</h3><p>Nuestro equipo se encarga de resolverlo.</p></article>
  </div>
</section>

<section class="section role-section">
  <div class="section-head"><div><span class="eyebrow">QCASA</span><h2>Una plataforma, cuatro experiencias simples.</h2></div><p>Cada perfil ve solo lo que necesita para que el proceso sea rápido.</p></div>
  <div class="role-grid">
    <a href="/r/AB123X" class="role-card"><span>01</span><h3>Inquilino</h3><p>QR → problema → foto → teléfono → enviar.</p></a>
    <a href="/propietario" class="role-card"><span>02</span><h3>Propietario</h3><p>Propiedades, reclamos y notificaciones.</p></a>
    <a href="/admin" class="role-card"><span>03</span><h3>Administrador</h3><p>Control total de la operación y estados.</p></a>
    <a href="/tecnico" class="role-card"><span>04</span><h3>Técnico</h3><p>Trabajos, agenda, historial y acciones rápidas.</p></a>
  </div>
</section>
{% endblock %}

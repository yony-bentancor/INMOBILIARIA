{% extends 'layouts/admin.njk' %}{% block content %}<div class="page-head"><div><span class="eyebrow">OPERACIÓN</span><h1>Reclamos</h1><p class="muted">Problemas reportados desde cada QR.</p></div></div><div class="data-table">{% for c in complaints %}<div><strong>#{{ c.number }}</strong><span>{{ c.property.address }}{% if c.property.unit %} · {{ c.property.unit }}{% endif %}</span><span>{{ c.title }}</span><span class="badge">{{ c.status }}</span><a href="/admin/reclamos/{{ c.number }}">Abrir</a></div>{% endfor %}</div>{% endblock %}

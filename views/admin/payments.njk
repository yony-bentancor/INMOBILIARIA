{% extends 'layouts/admin.njk' %}{% block content %}<div class="page-head"><div><span class="eyebrow">ALQUILERES</span><h1>Cobros</h1><p class="muted">Pagos esperados y recibidos.</p></div></div><section class="panel"><h2>Registrar cobro / expectativa</h2><form method="post" action="/admin/cobros/nuevo" class="form-grid"><label>Propiedad<select name="propertyCode">{% for p in properties %}<option value="{{ p.code }}">{{ p.address }} {{ p.unit }}</option>{% endfor %}</select></label><label>Período<input name="period" placeholder="2026-09"></label><label>Concepto<input name="concept" required></label><label>Vencimiento<input type="date" name="dueDate"></label><label>Importe<input type="number" name="amount" required></label><label>Moneda<input name="currency" value="UYU"></label><label>Estado<select name="status"><option>Pendiente</option><option>Pagado</option></select></label><label>Fecha pago<input type="date" name="paidAt"></label><label>Método<input name="method"></label><label>Referencia<input name="reference"></label><label class="full">Notas<textarea name="notes"></textarea></label><div class="full"><button class="btn btn-primary">Guardar</button></div></form></section><div class="data-table">{% for p in payments %}<div><span>{{ p.propertyCode }}</span><strong>{{ p.concept }}</strong><span>{{ p.dueDate }}</span><span>{{ money(p.amount,p.currency) }}</span><span class="badge">{{ p.status }}</span><span class="actions"><form method="post" action="/admin/cobros/{{ p.id }}/toggle"><button class="btn btn-light">{% if p.status == 'Pagado' %}Pendiente{% else %}Marcar pagado{% endif %}</button></form><form method="post" action="/admin/cobros/{{ p.id }}/eliminar"><button class="btn btn-danger">Eliminar</button></form></span></div>{% endfor %}</div>{% endblock %}

{% extends 'layouts/admin.njk' %}
{% block content %}
<section class="dashboard-shell admin-dashboard">
  <div class="dash-head">
    <div>
      <span class="eyebrow">ADMINISTRADOR</span>
      <h1>Operación QCASA</h1>
      <p class="muted">Toda la operación en un solo lugar.</p>
    </div>
  </div>

  <div class="stats stats-clickable">
    <a
      href="/admin?estado=urgentes#reclamos"
      class="stat-card stat-urgent {% if activeFilter == 'urgentes' %}active{% endif %}"
    >
      <strong>{{ stats.urgent }}</strong>
      <span>Urgentes</span>
      <small>Ver reclamos prioritarios</small>
    </a>

    <a
      href="/admin?estado=pendientes#reclamos"
      class="stat-card stat-pending {% if activeFilter == 'pendientes' %}active{% endif %}"
    >
      <strong>{{ stats.pending }}</strong>
      <span>Pendientes</span>
      <small>Nuevo + Revisando</small>
    </a>

    <a
      href="/admin?estado=encurso#reclamos"
      class="stat-card stat-progress {% if activeFilter == 'encurso' %}active{% endif %}"
    >
      <strong>{{ stats.inProgress }}</strong>
      <span>En curso</span>
      <small>Asignados y reparaciones</small>
    </a>

    <a
      href="/admin?estado=resueltos#reclamos"
      class="stat-card stat-resolved {% if activeFilter == 'resueltos' %}active{% endif %}"
    >
      <strong>{{ stats.resolved }}</strong>
      <span>Resueltos</span>
      <small>Trabajos finalizados</small>
    </a>
  </div>

  <section class="kanban-wrap" id="reclamos">
    <div class="panel-title reclamos-title">
      <div>
        <h2>
          {% if activeFilter == 'pendientes' %}
            Reclamos pendientes
          {% elif activeFilter == 'encurso' %}
            Reclamos en curso
          {% elif activeFilter == 'resueltos' %}
            Reclamos resueltos
          {% elif activeFilter == 'urgentes' %}
            Reclamos urgentes
          {% else %}
            Bandeja de reclamos
          {% endif %}
        </h2>

        <span class="muted">
          {% if activeFilter == 'pendientes' %}
            Mostrando solamente Nuevo y Revisando.
          {% elif activeFilter == 'encurso' %}
            Mostrando reclamos que ya están siendo gestionados.
          {% elif activeFilter == 'resueltos' %}
            Mostrando trabajos cerrados.
          {% elif activeFilter == 'urgentes' %}
            Mostrando reclamos con prioridad urgente o alta.
          {% else %}
            Mové la operación cambiando el estado.
          {% endif %}
        </span>
      </div>

      {% if activeFilter != 'todos' %}
        <a class="btn btn-light" href="/admin#reclamos">Ver todos</a>
      {% endif %}
    </div>

    {% if complaints|length == 0 %}
      <div class="empty-filter">
        <strong>No hay reclamos en esta categoría.</strong>
        <p>Cuando aparezcan, los vas a ver acá automáticamente.</p>
        <a href="/admin#reclamos" class="btn btn-light">Volver a todos</a>
      </div>
    {% else %}
      <div class="kanban">
        {% for col in columns %}
        <div class="kanban-col">
          <div class="kanban-heading">
            <h3>{{ col }}</h3>
            <span>
              {% set count = 0 %}
              {% for c in complaints %}
                {% if c.status == col %}
                  {% set count = count + 1 %}
                {% endif %}
              {% endfor %}
            </span>
          </div>

          {% for c in complaints %}
            {% if c.status == col %}
            <article class="ticket {% if c.priority == 'urgent' or c.priority == 'high' %}ticket-urgent{% endif %}">
              <div class="ticket-top">
                <b>#{{ c.number or c.id }}</b>
                <span>{{ c.category }}</span>
              </div>

              <h4>{{ c.title or c.category }}</h4>
              <p>{{ c.description }}</p>

              <div class="ticket-meta">
                <small>Propiedad: {{ c.propertyCode }}</small>

                {% if c.priority == 'urgent' %}
                  <span class="priority priority-urgent">Urgente</span>
                {% elif c.priority == 'high' %}
                  <span class="priority priority-high">Alta</span>
                {% endif %}
              </div>

              <form method="post" action="/admin/reclamos/{{ c.number or c.id }}/estado">
                <select name="status">
                  {% for s in ['Nuevo','Revisando','Técnico asignado','Aceptado','En camino','En reparación','Resuelto','Cancelado','Necesita presupuesto','Necesita repuesto'] %}
                    <option value="{{ s }}" {% if s == c.status %}selected{% endif %}>
                      {{ s }}
                    </option>
                  {% endfor %}
                </select>
                <button>Actualizar</button>
              </form>
            </article>
            {% endif %}
          {% endfor %}
        </div>
        {% endfor %}
      </div>
    {% endif %}
  </section>

  <section class="panel" id="propiedades">
    <div class="panel-title">
      <h2>Propiedades y QR</h2>
      <span class="muted">Cada propiedad tiene un código único.</span>
    </div>

    <div class="property-table">
      {% for p in properties %}
      <div>
        <span>
          <strong>{{ p.address }}</strong>
          — {{ p.unit }} · {{ p.code }}
        </span>
        <a class="btn btn-light" href="/admin/propiedades/{{ p.code }}/qr">
          Ver QR
        </a>
      </div>
      {% endfor %}
    </div>
  </section>

  <div class="admin-placeholder-grid">
    <section class="panel" id="propietarios">
      <h2>Propietarios</h2>
      <p class="muted">Alta y gestión de propietarios.</p>
    </section>

    <section class="panel" id="inquilinos">
      <h2>Inquilinos</h2>
      <p class="muted">Datos vinculados a cada propiedad.</p>
    </section>

    <section class="panel" id="tecnicos">
      <h2>Técnicos</h2>
      <p class="muted">Profesionales disponibles y especialidades.</p>
    </section>

    <section class="panel" id="agenda">
      <h2>Agenda</h2>
      <p class="muted">Visitas y trabajos programados.</p>
    </section>

    <section class="panel" id="notificaciones">
      <h2>Notificaciones</h2>
      <p class="muted">Historial de avisos enviados.</p>
    </section>

    <section class="panel" id="archivos">
      <h2>Archivos</h2>
      <p class="muted">Fotos, videos y documentos.</p>
    </section>

    <section class="panel" id="configuracion">
      <h2>Configuración</h2>
      <p class="muted">Datos generales y futuras integraciones.</p>
    </section>
  </div>
</section>
{% endblock %}

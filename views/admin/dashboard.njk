{% extends 'layouts/main.njk' %}{% block content %}
<section class="dashboard-shell"><div class="dash-head"><div><span class="eyebrow">ADMINISTRADOR</span><h1>Operación QCASA</h1></div><div class="admin-menu"><a>Panel</a><a>Reclamos</a><a>Propiedades</a><a>Propietarios</a><a>Inquilinos</a><a>Técnicos</a><a>Agenda</a><a>Configuración</a></div></div>
<div class="stats"><div class="danger"><strong>3</strong><span>Urgentes</span></div><div><strong>5</strong><span>Pendientes</span></div><div><strong>4</strong><span>Técnicos asignados</span></div><div><strong>7</strong><span>Resueltos hoy</span></div></div>
<section class="kanban-wrap"><div class="panel-title"><h2>Bandeja de reclamos</h2><span class="muted">Vista estilo Trello</span></div><div class="kanban">{% for col in columns %}<div class="kanban-col"><h3>{{ col }}</h3>{% for c in complaints %}{% if c.status == col %}<article class="ticket"><div class="ticket-top"><b>#{{ c.number or c.id }}</b><span>{{ c.category }}</span></div><h4>{{ c.title or c.category }}</h4><p>{{ c.description }}</p><form method="post" action="/admin/reclamos/{{ c.number or c.id }}/estado"><select name="status">{% for s in ['Nuevo','Revisando','Técnico asignado','Aceptado','En camino','En reparación','Resuelto','Cancelado','Necesita presupuesto','Necesita repuesto'] %}<option {% if s == c.status %}selected{% endif %}>{{ s }}</option>{% endfor %}</select><button>Actualizar</button></form></article>{% endif %}{% endfor %}</div>{% endfor %}</div></section>
<section class="panel"><div class="panel-title"><h2>QR de propiedades</h2></div><div class="property-table">{% for p in properties %}<div><span>{{ p.address }} — {{ p.unit }}</span><a class="btn btn-light" href="/admin/propiedades/{{ p.code }}/qr">Ver QR</a></div>{% endfor %}</div></section></section>{% endblock %}

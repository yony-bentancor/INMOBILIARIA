{% extends 'layouts/admin.njk' %}{% block content %}<div class="page-head"><div><span class="eyebrow">ADMINISTRADOR</span><h1>Panel de control</h1><p class="muted">Propiedades, vencimientos, cobros y reclamos.</p></div><a href="/admin/propiedades/nueva" class="btn btn-primary">+ Nueva propiedad</a></div>{% include 'partials/flash-note.njk' %}<div class="stats-grid"><a href="/admin/propiedades" class="stat-card"><strong>{{ stats.properties }}</strong><span>Propiedades</span></a><a href="/admin/reclamos" class="stat-card"><strong>{{ stats.openClaims }}</strong><span>Reclamos abiertos</span></a><a href="/admin/vencimientos" class="stat-card"><strong>{{ stats.alerts }}</strong><span>Alertas próximas</span></a><a href="/admin/cobros" class="stat-card"><strong>{{ stats.pendingPayments }}</strong><span>Cobros pendientes</span></a></div><div class="two-col"><section class="panel"><div class="panel-head"><h2>Requiere atención</h2><a href="/admin/vencimientos">Ver todo</a></div><div class="attention-list">{% for a in attention %}<a href="/admin/propiedades/{{ a.propertyCode }}" class="attention-item"><span class="dot dot-{{ a.level }}"></span><div><strong>{{ a.title }}</strong><span>{{ a.property.address }}{% if a.property.unit %} · {{ a.property.unit }}{% endif %}</span></div><small>{{ a.statusText }}</small></a>{% else %}<p class="muted">Sin alertas próximas.</p>{% endfor %}</div></section><section class="panel"><div class="panel-head"><h2>Últimos reclamos</h2><a href="/admin/reclamos">Ver todos</a></div><div class="attention-list">{% for c in latestClaims %}<a href="/admin/reclamos/{{ c.number }}" class="attention-item"><span class="dot dot-warning"></span><div><strong>#{{ c.number }} · {{ c.title }}</strong><span>{{ c.propertyCode }} · {{ c.status }}</span></div></a>{% endfor %}</div></section></div>{% endblock %}

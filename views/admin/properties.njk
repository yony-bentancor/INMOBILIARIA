{% extends 'layouts/admin.njk' %}{% block content %}<div class="page-head"><div><span class="eyebrow">INMUEBLES</span><h1>Propiedades</h1><p class="muted">Ficha completa de cada inmueble administrado.</p></div><a href="/admin/propiedades/nueva" class="btn btn-primary">+ Nueva propiedad</a></div><div class="property-grid">{% for p in properties %}<article class="property-card"><img src="{{ p.coverPhoto }}" alt="Fachada"><div class="property-card-body"><div class="row-between"><span class="badge">{{ p.type }}</span>{% if p.active %}<span class="badge badge-ok">Activa</span>{% else %}<span class="badge badge-muted">Inactiva</span>{% endif %}</div><h2>{{ p.address }}</h2><p>{{ p.unit or 'Sin unidad' }} · {{ p.neighborhood }}</p><p class="muted">Padrón {{ p.cadastralNumber }} · {{ p.code }}</p><a href="/admin/propiedades/{{ p.code }}" class="btn btn-dark btn-block">Abrir ficha</a></div></article>{% endfor %}</div>{% endblock %}

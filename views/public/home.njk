{% extends 'layouts/base.njk' %}
{% block body %}
<link rel="stylesheet" href="/css/qpropiedades-front.css">

<div class="qp-page">
  <header class="qp-nav">
    <a class="qp-brand" href="/" aria-label="QPROPIEDADES">
      <span class="qp-brand-mark">Q</span>
      <span class="qp-brand-name">QPROPIEDADES</span>
      <small>GESTIÓN INTELIGENTE<br>DE PROPIEDADES</small>
    </a>

    <nav class="qp-menu" aria-label="Navegación principal">
      <a href="#como-funciona">Cómo funciona</a>
      <a href="#propietarios">Para propietarios</a>
      <a href="#servicios">Servicios</a>
      <a href="/ingresar" class="qp-login">Ingresar</a>
    </nav>
  </header>

  <main>
    <section class="qp-hero">
      <div class="qp-hero-copy">
        <span class="qp-kicker">GESTIÓN INTEGRAL DE PROPIEDADES</span>
        <h1>Tu propiedad,<br><em>bajo control.</em></h1>

        <p class="qp-lead">
          Alquileres, vencimientos, documentos, inquilinos,
          reparaciones e historial. Toda la información de tu propiedad,
          en un solo lugar.
        </p>

        <div class="qp-actions">
          <a href="/alta" class="qp-btn qp-btn-primary">Gestionar mis propiedades</a>
          <a href="#como-funciona" class="qp-btn qp-btn-outline">Ver cómo funciona →</a>
        </div>

        <div class="qp-tenant-links">
          <span>¿Sos inquilino?</span>
          <button type="button" class="qp-text-link" data-open-qr-reader>Escanear QR</button>
          <span class="qp-dot">·</span>
          <a class="qp-text-link" href="/seguimiento">Ver mi reclamo</a>
        </div>
      </div>

      <div class="qp-hero-visual" aria-label="Propiedad gestionada con QPROPIEDADES">
        <div class="qp-building" aria-hidden="true">
          <div class="qp-building-floor qp-floor-3"><i></i><i></i><i></i></div>
          <div class="qp-building-floor qp-floor-2"><i></i><i></i><i></i></div>
          <div class="qp-building-floor qp-floor-1"><i></i><i></i><i></i></div>
          <div class="qp-building-ground"><span></span><span></span></div>
        </div>

        <div class="qp-phone">
          <div class="qp-phone-screen">
            <div class="qp-phone-head">
              <span><b>Q</b> QPROPIEDADES</span>
              <strong>QP-24</strong>
            </div>
            <h3>¿NECESITÁS ALGO?</h3>
            <p>ESCANEÁ Y REPORTALO</p>
            <img src="/img/landing/qr-demo.png" alt="QR de demostración">
            <small>Rápido, simple y seguro.</small>
          </div>
        </div>
      </div>
    </section>

    <section class="qp-services" id="servicios">
      <h2>TODO LO QUE NECESITÁS, EN UN SOLO LUGAR</h2>
      <div class="qp-service-grid">
        <article><span>⌂</span><div><b>Propiedades</b><small>Datos, ubicación e historial.</small></div></article>
        <article><span>◎</span><div><b>Inquilinos</b><small>Información y contrato.</small></div></article>
        <article><span>$</span><div><b>Alquileres</b><small>Cobros y vencimientos.</small></div></article>
        <article><span>▤</span><div><b>Documentos</b><small>Contratos e impuestos.</small></div></article>
        <article><span>⌕</span><div><b>Mantenimiento</b><small>Reclamos y reparaciones.</small></div></article>
        <article><span>◌</span><div><b>Alertas</b><small>Lo importante, a tiempo.</small></div></article>
      </div>
    </section>

    <section class="qp-overview" id="como-funciona">
      <div class="qp-mini-dashboard" aria-hidden="true">
        <div class="qp-mini-sidebar"><b>Q</b><i></i><i></i><i></i><i></i></div>
        <div class="qp-mini-content">
          <strong>Mis propiedades</strong>
          <div class="qp-mini-cards">
            <span><b>12</b> Propiedades</span>
            <span><b>11</b> Alquiladas</span>
            <span><b>2</b> Alertas</span>
          </div>
          <div class="qp-mini-lines"><i></i><i></i><i></i><i></i></div>
        </div>
      </div>

      <div class="qp-overview-copy" id="propietarios">
        <span class="qp-kicker">UNA VISIÓN COMPLETA</span>
        <h2>Cada propiedad, clara y ordenada.</h2>
        <p>Consultá en segundos qué está al día, qué vence y qué necesita atención.</p>
        <a href="/alta" class="qp-btn qp-btn-outline">Quiero usar QPROPIEDADES →</a>
      </div>
    </section>
  </main>

  <footer class="qp-footer">
    <div class="qp-footer-brand">
      <span class="qp-brand-mark">Q</span>
      <div><b>QPROPIEDADES</b><small>Gestión inteligente de propiedades.</small></div>
    </div>
    <div class="qp-footer-links">
      <a href="#como-funciona">Cómo funciona</a>
      <a href="/alta">Contacto</a>
      <a href="/ingresar">Ingresar</a>
    </div>
    <small>© 2026 QPROPIEDADES</small>
  </footer>

  <div class="qr-reader-modal" data-qr-reader-modal hidden>
    <div class="qr-reader-backdrop" data-close-qr-reader></div>
    <section class="qr-reader-card" role="dialog" aria-modal="true" aria-labelledby="qr-reader-title">
      <button type="button" class="qr-reader-close" data-close-qr-reader aria-label="Cerrar">×</button>
      <span class="qp-kicker">QR DE LA PROPIEDAD</span>
      <h2 id="qr-reader-title">Escanear QR</h2>
      <p>Apuntá la cámara al QR de la propiedad.</p>

      <div class="qr-reader-camera">
        <video data-qr-video playsinline muted></video>
        <div class="qr-reader-frame"></div>
      </div>

      <p class="qr-reader-status" data-qr-status>Presioná “Activar cámara” para comenzar.</p>

      <button type="button" class="qp-btn qp-btn-primary qr-reader-start" data-start-qr>
        Activar cámara
      </button>

      <div class="qr-reader-manual">
        <span>También podés ingresar el código:</span>
        <div>
          <input type="text" data-qr-code placeholder="Ej: QC-0001" autocomplete="off">
          <button type="button" class="qp-btn qp-btn-dark" data-go-qr>Ir</button>
        </div>
      </div>
    </section>
  </div>
</div>
{% endblock %}

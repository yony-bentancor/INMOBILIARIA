{% extends 'layouts/main.njk' %}{% block content %}<section class="dashboard-shell"><div class="dash-head"><div><span class="eyebrow">TÉCNICO</span><h1>Trabajos</h1></div><div class="admin-menu"><a>Trabajos</a><a>Agenda</a><a>Historial</a><a>Mi perfil</a></div></div><div class="jobs-grid">{% for c in complaints %}<article class="job-card"><div class="ticket-top"><b>Trabajo #{{ c.number or c.id }}</b><span>{{ c.category }}</span></div><h2>{{ c.title or c.category }}</h2><p>{{ c.description }}</p><div class="job-meta"><span>Zona: {{ c.propertyCode }}</span><span>Prioridad: {{ c.priority }}</span></div><form method="post" action="/tecnico/trabajos/{{ c.number or c.id }}/estado" class="tech-actions">{% for s in ['Aceptado','En camino','En reparación','Resuelto','Necesita repuesto'] %}<button name="status" value="{{ s }}" class="btn {% if s == 'Resuelto' %}btn-primary{% else %}btn-light{% endif %}">{{ s }}</button>{% endfor %}</form></article>{% else %}<p>No hay trabajos asignados.</p>{% endfor %}</div></section>{% endblock %}

<header class="site-header">
  <a class="brand" href="/">
    <img src="/img/logo-qcasa.svg" alt="QCASA">
  </a>
  <nav class="main-nav" id="mainNav">
    <a href="/" class="active">Inicio</a>
    <a href="/propiedades">Propiedades</a>
    <a href="/reparaciones">Reparaciones</a>
    <a href="/propietarios">Propietarios</a>
    <a href="/tecnicos">Técnicos</a>
    <a href="/contacto">Contacto</a>
  </nav>
  <div class="header-actions">
    {% if sessionUser %}
      <a class="btn btn-outline" href="/{% if sessionUser.role == 'admin' %}admin{% elif sessionUser.role == 'owner' %}propietario{% else %}tecnico{% endif %}">Mi panel</a>
      <form method="post" action="/salir"><button class="btn btn-ghost">Salir</button></form>
    {% else %}
      <a class="btn btn-outline" href="/ingresar">Ingresar</a>
    {% endif %}
    <a class="btn btn-primary" href="/r/AB123X">🔧 Reportar problema</a>
  </div>
  <button class="menu-toggle" data-menu>☰</button>
</header>

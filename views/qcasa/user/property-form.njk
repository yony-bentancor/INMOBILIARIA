{% extends 'qcasa/layout.njk' %}
{% block qcbody %}
<main class="qc-admin qc-admin-form-page">
  <a class="qc-back" href="/qcasa/mi-qcasa">← Volver a Mi QCASA</a>

  <div class="qc-admin-head">
    <div>
      <span class="qc-kicker">{{ 'CORREGIR PUBLICACIÓN' if mode=='edit' else 'PUBLICACIÓN PARA REVISIÓN' }}</span>
      <h1>{{ 'Editar propiedad' if mode=='edit' else 'Publicar mi propiedad' }}</h1>
      <p>
        {% if mode=='edit' %}
          Podés corregir los datos y agregar nuevas fotos. Si estaba rechazada, quedará en borrador hasta que la reenvíes.
        {% else %}
          La propiedad no se publica automáticamente. Primero la revisa el administrador de QCASA.
        {% endif %}
      </p>
    </div>
  </div>

  {% if error %}<div class="qc-error qc-form-error">{{ error }}</div>{% endif %}

  <form class="qc-property-form" method="post" enctype="multipart/form-data"
        action="{{ '/qcasa/mi-qcasa/propiedades/' + property.id if mode=='edit' else '/qcasa/mi-qcasa/propiedades' }}">

    <label class="qc-wide">
      Título
      <input name="title" value="{{ property.title if property else '' }}" required>
    </label>

    <label>
      Tipo
      <select name="category">
        {% for c in categories %}
          <option value="{{ c }}" {% if property and property.category==c %}selected{% endif %}>{{ c }}</option>
        {% endfor %}
      </select>
    </label>

    <label>
      Operación
      <select name="operation">
        <option value="Venta" {% if property and property.operation=='Venta' %}selected{% endif %}>Venta</option>
        <option value="Alquiler" {% if property and property.operation=='Alquiler' %}selected{% endif %}>Alquiler</option>
      </select>
    </label>

    <label>
      Departamento
      <select name="department">
        {% for d in departments %}
          <option value="{{ d }}" {% if (property and property.department==d) or (not property and d=='Colonia') %}selected{% endif %}>{{ d }}</option>
        {% endfor %}
      </select>
      <small class="qc-field-help">MVP disponible actualmente en Colonia.</small>
    </label>

    <label>
      Ciudad / barrio / zona
      <input name="city" value="{{ property.city if property else '' }}" required>
    </label>

    <label>
      Moneda
      <select name="currency">
        <option value="USD" {% if not property or property.currency=='USD' %}selected{% endif %}>USD</option>
        <option value="UYU" {% if property and property.currency=='UYU' %}selected{% endif %}>UYU</option>
      </select>
    </label>

    <label>
      Precio
      <input type="number" name="price" min="1" value="{{ property.price if property else '' }}" required>
    </label>

    <label>
      Dormitorios
      <input type="number" name="bedrooms" min="0" value="{{ property.bedrooms if property else 0 }}">
    </label>

    <label>
      Baños
      <input type="number" name="bathrooms" min="0" value="{{ property.bathrooms if property else 1 }}">
    </label>

    <label>
      Superficie m²
      <input type="number" name="area" min="1" value="{{ property.area if property else '' }}" required>
    </label>

    <label>
      Teléfono de contacto
      <input name="contact" value="{{ property.contact if property else user.phone }}" required>
    </label>

    <label class="qc-wide">
      Fotos
      <input type="file" name="photos" accept="image/*" multiple>
      <small class="qc-field-help">Podés cargar hasta 8 imágenes. Las nuevas se agregan a las existentes.</small>
    </label>

    {% if property and property.images and property.images.length %}
      <div class="qc-wide qc-photo-preview">
        {% for photo in property.images %}
          <img src="{{ photo }}" alt="Foto de la propiedad">
        {% endfor %}
      </div>
    {% endif %}

    <label class="qc-wide">
      Descripción
      <textarea name="summary" rows="6" required>{{ property.summary if property else '' }}</textarea>
    </label>

    <div class="qc-wide qc-submit-review">
      <div>
        <b>{{ 'Guardar cambios' if mode=='edit' else 'Antes de publicarse' }}</b>
        <span>
          {% if mode=='edit' %}
            Si la publicación estaba rechazada, después de guardar vas a poder reenviarla a revisión desde Mi QCASA.
          {% else %}
            QCASA revisará la información y vas a recibir una notificación cuando sea aprobada o rechazada.
          {% endif %}
        </span>
      </div>
      <button>{{ 'Guardar cambios' if mode=='edit' else 'Enviar a revisión' }}</button>
    </div>
  </form>
</main>
{% endblock %}

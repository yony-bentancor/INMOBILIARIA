{% extends 'qcasa/layout.njk' %}{% block qcbody %}<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"><main class="qc-map-page qc-public-surface"><section class="qc-map-head"><div><span class="qc-kicker">EXPLORAR</span><h1>Propiedades en el mapa</h1><p>Mové el mapa, acercate a una zona y abrí cada propiedad.</p></div><div class="qc-map-head-actions"><a href="/qcasa/buscar{% if queryString %}?{{ queryString }}{% endif %}">☷ Ver listado</a><a href="/qcasa/buscar">Filtros avanzados</a></div></section><section class="qc-map-shell"><div id="qcPropertyMap" class="qc-property-map"></div><aside class="qc-map-side"><div class="qc-map-side-head"><b>{{ results.length }} propiedades</b><span>Seleccioná un marcador</span></div><div id="qcMapSelected" class="qc-map-selected"><div class="qc-map-placeholder"><b>Explorá el mapa</b><span>Los marcadores muestran precio y ubicación.</span></div></div></aside></section></main><script>window.QCASA_MAP_PROPERTIES={{ mapProperties|safe }};window.QCASA_MAP_FOCUS="{{ focusProperty or '' }}";</script><script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script><script src="/js/qcasa-map.js"></script>{% endblock %}
{% extends 'qcasa/layout.njk' %}{% block qcbody %}<main class="qc-detail qc-public-surface qc-detail-premium"><div class="qc-detail-topbar"><a class="qc-back" href="/qcasa/buscar">← Volver a propiedades</a><div><a href="{{ shareWhatsApp }}" target="_blank" rel="noopener" class="qc-share-btn">Compartir por WhatsApp</a>{% if whatsappQcasa %}<a href="{{ whatsappQcasa }}" target="_blank" rel="noopener" class="qc-contact-wa">Consultar por WhatsApp</a>{% endif %}</div></div>
<section class="qc-detail-grid"><div class="qc-detail-photo"><img src="{{ property.image }}" alt="{{ property.title }}" style="width:100%;height:100%;object-fit:cover;display:block;"><span>{{ property.category }}</span>{% if property.videoUrl %}<em class="qc-video-badge">▶ Video disponible</em>{% endif %}<b>QCASA</b></div><div class="qc-detail-info"><span class="qc-kicker">{{ property.operation }} · {{ property.department }}</span><h1>{{ property.title }}</h1><strong class="qc-price">{{ money(property) }}</strong><p class="qc-location">{{ property.city }}</p><div class="qc-features"><span>{{ property.area|int }} m²</span>{% if property.bedrooms %}<span>{{ property.bedrooms }} dormitorios</span>{% endif %}{% if property.bathrooms %}<span>{{ property.bathrooms }} baños</span>{% endif %}{% if property.garage %}<span>Garage</span>{% endif %}{% if property.garden %}<span>Jardín</span>{% endif %}</div><p class="qc-description">{{ property.summary }}</p><div class="qc-id">Referencia {{ property.id }}</div></div></section>
{% if property.videoUrl %}<section class="qc-property-video"><div><span class="qc-kicker">RECORRIDO</span><h2>Conocé la propiedad en video</h2></div>{% if 'youtube.com/embed/' in property.videoUrl %}<iframe src="{{ property.videoUrl }}" title="Video de {{ property.title }}" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>{% else %}<video controls preload="metadata" poster="{{ property.image }}"><source src="{{ property.videoUrl }}">Tu navegador no puede reproducir este video.</video>{% endif %}</section>{% endif %}
<section class="qc-detail-lower"><div class="qc-property-sheet"><span class="qc-kicker">FICHA DE LA PROPIEDAD</span><h2>Información y ubicación</h2><div class="qc-spec-grid"><div><small>Operación</small><b>{{ property.operation }}</b></div><div><small>Tipo</small><b>{{ property.category }}</b></div><div><small>Superficie</small><b>{{ property.area|int }} m²</b></div><div><small>Dormitorios</small><b>{{ property.bedrooms or '—' }}</b></div><div><small>Baños</small><b>{{ property.bathrooms or '—' }}</b></div><div><small>Zona</small><b>{{ property.city }}</b></div></div>{% if property.lat and property.lng %}<div class="qc-detail-map-wrap"><iframe title="Mapa" loading="lazy" src="https://www.google.com/maps?q={{ property.lat }},{{ property.lng }}&z=14&output=embed"></iframe><a href="/qcasa/mapa?property={{ property.id }}">Ver esta propiedad en el mapa interactivo →</a></div>{% endif %}</div>
<aside class="qc-contact-box qc-contact-compact"><div><span class="qc-kicker">CONSULTAR</span><h2>¿Querés saber más?</h2><p>QCASA registra la consulta y te acompaña en el contacto.</p></div>{% if consulted %}<div class="qc-success">✓ Consulta recibida.</div>{% else %}<form action="/qcasa/propiedad/{{ property.slug }}/consulta" method="post"><input name="name" placeholder="Nombre" required><input name="phone" placeholder="Teléfono" required><input type="email" name="email" placeholder="Email"><textarea name="message" rows="3" placeholder="Mensaje"></textarea><button>Enviar consulta</button></form>{% endif %}<div class="qc-contact-secondary">{% if whatsappQcasa %}<a href="{{ whatsappQcasa }}" target="_blank" rel="noopener">Hablar con QCASA por WhatsApp</a>{% endif %}<a href="{{ shareWhatsApp }}" target="_blank" rel="noopener">Compartir con un conocido</a></div></aside></section></main>{% endblock %}
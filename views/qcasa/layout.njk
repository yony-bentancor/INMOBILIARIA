{% extends 'layouts/base.njk' %}
{% block body %}
<link rel="stylesheet" href="/css/qcasa.css"><link rel="stylesheet" href="/css/qcasa-colonia.css"><link rel="stylesheet" href="/css/qcasa-mvp.css"><link rel="stylesheet" href="/css/qcasa-polish.css">
<div class="qc-page"><header class="qc-nav qc-colonia-nav qc-nav-unified"><a class="qc-brand" href="/qcasa"><span class="qc-mark">Q</span><span class="qc-name">QCASA</span></a><nav class="qc-main-nav">
<a data-qc-nav="Venta" href="/qcasa/buscar?operation=Venta">Comprar</a><a data-qc-nav="Alquiler" href="/qcasa/buscar?operation=Alquiler">Alquilar</a><a data-qc-nav="Buscar" href="/qcasa/buscar">Buscar</a><a data-qc-nav="Mapa" href="/qcasa/mapa">Mapa</a>
<a class="qc-publish-nav" href="{{ '/qcasa/mi-qcasa/publicar' if session.qcasaUser else '/qcasa/registro?publicar=1' }}">Publicar propiedad</a>
<form class="qc-currency-switch" method="post" action="/qcasa/moneda"><select name="currencyMode" onchange="this.form.submit()" aria-label="Moneda"><option value="USD" {% if session.qcasaCurrency != 'UYU' %}selected{% endif %}>USD</option><option value="UYU" {% if session.qcasaCurrency == 'UYU' %}selected{% endif %}>UYU</option></select></form>
{% if session.qcasaUser %}<div class="qc-nav-dropdown"><button type="button">Mi cuenta ▾</button><div class="qc-nav-menu qc-nav-menu-right"><a href="/qcasa/mi-qcasa">Mi QCASA</a><a href="/qcasa/mi-qcasa/publicar">Publicar propiedad</a><form method="post" action="/qcasa/salir"><button type="submit">Salir</button></form></div></div>{% else %}<a href="/qcasa/ingresar" class="qc-login">Ingresar</a>{% endif %}
</nav></header>{% block qcbody %}{% endblock %}<footer class="qc-footer"><div><b>QCASA</b><small>Comprar · Alquilar · Buscar · Publicar</small></div><div><a href="/">Estudio QR</a><a href="/qpropiedades">QPROPIEDADES</a><a href="/qcasa/buscar">Propiedades</a></div><small>© 2026 QCASA</small></footer></div>
<script>(function(){const path=location.pathname,qs=new URLSearchParams(location.search);let key='';if(path==='/qcasa/mapa')key='Mapa';else if(path==='/qcasa/buscar')key=qs.get('operation')||'Buscar';document.querySelectorAll('[data-qc-nav]').forEach(a=>a.classList.toggle('is-active',a.dataset.qcNav===key));})();</script>
{% endblock %}
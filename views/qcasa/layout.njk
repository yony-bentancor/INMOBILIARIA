{% extends 'layouts/base.njk' %}
{% block body %}
<link rel="stylesheet" href="/css/qcasa.css"><link rel="stylesheet" href="/css/qcasa-colonia.css"><link rel="stylesheet" href="/css/qcasa-mvp.css"><link rel="stylesheet" href="/css/qcasa-polish.css"><link rel="stylesheet" href="/css/qcasa-mobile.css">
<div class="qc-page" id="qcTop"><header class="qc-nav qc-colonia-nav qc-nav-unified"><a class="qc-brand" href="/qcasa"><span class="qc-mark">Q</span><span class="qc-name">QCASA</span></a>
<button class="qc-mobile-menu-toggle" type="button" aria-label="Abrir menú" aria-expanded="false" data-qc-mobile-menu><span></span><span></span><span></span></button>
<nav class="qc-main-nav" data-qc-main-nav><button class="qc-mobile-menu-close" type="button" aria-label="Cerrar menú" data-qc-mobile-close>×</button>
<a data-qc-nav="Venta" href="/qcasa/buscar?operation=Venta">Comprar</a><a data-qc-nav="Alquiler" href="/qcasa/buscar?operation=Alquiler">Alquilar</a><a data-qc-nav="Buscar" href="/qcasa/buscar">Buscar</a><a data-qc-nav="Mapa" href="/qcasa/mapa">Mapa</a>
<a class="qc-publish-nav qc-publish-plain" href="{{ '/qcasa/mi-qcasa/publicar' if session.qcasaUser else '/qcasa/registro?publicar=1' }}">Publicar propiedad</a>
<form class="qc-currency-switch" method="post" action="/qcasa/moneda"><select name="currencyMode" onchange="this.form.submit()" aria-label="Moneda"><option value="USD" {% if session.qcasaCurrency != 'UYU' %}selected{% endif %}>USD</option><option value="UYU" {% if session.qcasaCurrency == 'UYU' %}selected{% endif %}>UYU</option></select></form>
{% if session.qcasaUser %}<div class="qc-nav-dropdown"><button type="button">Mi cuenta ▾</button><div class="qc-nav-menu qc-nav-menu-right"><a href="/qcasa/mi-qcasa">Mi QCASA</a><a href="/qcasa/mi-qcasa/publicar">Publicar propiedad</a><form method="post" action="/qcasa/salir"><button type="submit">Salir</button></form></div></div><div class="qc-mobile-account"><a href="/qcasa/mi-qcasa">Mi QCASA</a><form method="post" action="/qcasa/salir"><button type="submit">Salir</button></form></div>{% else %}<a href="/qcasa/ingresar" class="qc-login">Ingresar</a>{% endif %}
</nav></header><div class="qc-mobile-menu-backdrop" data-qc-mobile-backdrop></div>
{% block qcbody %}{% endblock %}
<footer class="qc-footer qc-footer-minimal"><div><b>QCASA</b><small>Comprar · Alquilar · Buscar · Publicar</small></div><div class="qc-footer-studio"><a href="/">Estudio QR</a></div><small class="qc-footer-copyright">© 2026 QCASA</small><a class="qc-back-to-top" href="#qcTop" data-qc-back-top>↑ Volver arriba</a></footer>

<button class="qc-favorites-fab" type="button" data-qc-open-favorites hidden aria-label="Abrir favoritos">♡ <span data-qc-fav-count>0</span></button>
<div class="qc-drawer-backdrop" data-qc-drawer-backdrop></div><aside class="qc-saved-drawer" data-qc-saved-drawer><button class="qc-drawer-close" type="button" data-qc-close-drawer>×</button><div data-qc-drawer-content></div></aside>
<div class="qc-compare-bar" data-qc-compare-bar hidden><span><b data-qc-compare-count>0</b> propiedades para comparar</span><button type="button" data-qc-open-compare>Comparar ahora</button><button type="button" data-qc-clear-compare>Limpiar</button></div>
</div>
<script src="/js/qcasa-experience.js" defer></script><script src="/js/qcasa-mobile-nav.js" defer></script>
<script>(function(){const path=location.pathname,qs=new URLSearchParams(location.search);let key='';if(path==='/qcasa/mapa')key='Mapa';else if(path==='/qcasa/buscar')key=qs.get('operation')||'Buscar';document.querySelectorAll('[data-qc-nav]').forEach(a=>a.classList.toggle('is-active',a.dataset.qcNav===key));})();</script>
{% endblock %}
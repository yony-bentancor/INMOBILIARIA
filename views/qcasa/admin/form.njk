{% extends 'qcasa/layout.njk' %}
{% block qcbody %}
<main class="qc-admin qc-admin-form-page">
  <a class="qc-back" href="/qcasa/admin">← Volver al panel</a>
  <div class="qc-admin-head"><div><span class="qc-kicker">ADMINISTRACIÓN QCASA</span><h1>{{ 'Editar propiedad' if property else 'Cargar propiedad' }}</h1></div></div>
  <form class="qc-property-form" method="post" action="{{ '/qcasa/admin/propiedades/' + property.id if property else '/qcasa/admin/propiedades' }}">
    <label class="qc-wide">Título<input name="title" value="{{ property.title if property else '' }}" required></label>
    <label>Tipo<select name="category">{% for c in categories %}<option value="{{ c }}" {% if property and property.category==c %}selected{% endif %}>{{ c }}</option>{% endfor %}</select></label>
    <label>Operación<select name="operation"><option value="Venta" {% if property and property.operation=='Venta' %}selected{% endif %}>Venta</option><option value="Alquiler" {% if property and property.operation=='Alquiler' %}selected{% endif %}>Alquiler</option></select></label>
    <label>Departamento<input name="department" value="{{ property.department if property else 'Montevideo' }}" required></label>
    <label>Ciudad / barrio<input name="city" value="{{ property.city if property else '' }}" required></label>
    <label>Moneda<select name="currency"><option value="USD" {% if not property or property.currency=='USD' %}selected{% endif %}>USD</option><option value="UYU" {% if property and property.currency=='UYU' %}selected{% endif %}>UYU</option></select></label>
    <label>Precio<input type="number" name="price" value="{{ property.price if property else '' }}" required></label>
    <label>Dormitorios<input type="number" name="bedrooms" value="{{ property.bedrooms if property else 0 }}"></label>
    <label>Baños<input type="number" name="bathrooms" value="{{ property.bathrooms if property else 1 }}"></label>
    <label>Superficie m²<input type="number" name="area" value="{{ property.area if property else '' }}" required></label>
    <label>Teléfono de contacto<input name="contact" value="{{ property.contact if property else '' }}"></label>
    <label class="qc-wide">Descripción<textarea name="summary" rows="5" required>{{ property.summary if property else '' }}</textarea></label>
    <label class="qc-check qc-wide"><input type="checkbox" name="featured" {% if property and property.featured %}checked{% endif %}> Marcar como destacada</label>
    <div class="qc-wide"><button>Guardar propiedad</button></div>
  </form>
</main>
{% endblock %}

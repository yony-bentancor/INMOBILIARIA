{% extends 'qcasa/layout.njk' %}
{% block qcbody %}
<main class="qc-admin qc-admin-control">
  <div class="qc-admin-head">
    <div>
      <span class="qc-kicker">ADMINISTRADOR</span>
      <h1>Centro de control</h1>
      <p>Lo que necesita atención hoy en QCASA.</p>
    </div>
    {% include 'qcasa/admin/_nav.njk' %}
  </div>

  <section class="qc-stats qc-dashboard-kpis">
    <article><small>Publicadas</small><b>{{ stats.published }}</b><span>oferta visible</span></article>
    <article class="qc-stat-pending"><small>Pendientes aprobación</small><b>{{ stats.pending }}</b><span>requieren revisión</span></article>
    <article><small>Consultas</small><b>{{ stats.inquiries }}</b><span>actividad comercial</span></article>
    <article><small>Usuarios</small><b>{{ stats.users }}</b><span>propietarios registrados</span></article>
    <article><small>Venta / alquiler</small><b>{{ stats.sale }} / {{ stats.rent }}</b><span>composición de cartera</span></article>
  </section>

  <section class="qc-admin-panel qc-activity-panel">
    <div class="qc-panel-head">
      <div>
        <span class="qc-kicker">ACTIVIDAD COMERCIAL</span>
        <h2>Embudo de consultas</h2>
      </div>
      <a href="/qcasa/admin/consultas">Ver consultas →</a>
    </div>

    <div class="qc-funnel">
      <article><small>Consultas</small><b>{{ activity.total }}</b></article>
      <i>→</i>
      <article><small>Contactadas</small><b>{{ activity.contacted }}</b></article>
      <i>→</i>
      <article><small>Visitas</small><b>{{ activity.visits }}</b></article>
      <i>→</i>
      <article><small>Negociaciones</small><b>{{ activity.negotiations }}</b></article>
      <i>→</i>
      <article><small>Cerradas</small><b>{{ activity.closed }}</b></article>
    </div>

    <div class="qc-funnel-metrics">
      <div><small>Tasa de respuesta</small><b>{{ activity.responsePct }}%</b></div>
      <div><small>Conversión a visita</small><b>{{ activity.visitPct }}%</b></div>
      <div><small>Conversión final</small><b>{{ activity.closePct }}%</b></div>
    </div>
  </section>

  <section class="qc-dashboard-grid">
    <div class="qc-admin-panel">
      <div class="qc-panel-head"><h2>Requiere atención</h2><span>prioridades del día</span></div>
      <div class="qc-attention-list">
        <a href="#pendientes"><b>{{ attention.pendingCount }}</b><span>Publicaciones pendientes</span><em>Revisar →</em></a>
        <a href="/qcasa/admin/consultas"><b>{{ attention.newInquiryCount }}</b><span>Consultas nuevas sin gestionar</span><em>Responder →</em></a>
        <a href="/qcasa/admin"><b>{{ attention.rejectedCount }}</b><span>Publicaciones rechazadas esperando corrección</span><em>Ver →</em></a>
        <a href="#cambios"><b>{{ attention.changeCount }}</b><span>Cambios de publicaciones esperando aprobación</span><em>Revisar →</em></a>
        <a href="/qcasa/admin"><b>{{ attention.staleCount }}</b><span>Publicaciones sin consultas por varios días</span><em>Revisar →</em></a>
      </div>
    </div>

    <div class="qc-admin-panel">
      <div class="qc-panel-head"><h2>Rendimiento de publicaciones</h2><span>señales comerciales</span></div>
      <div class="qc-performance-list">
        {% for p in performance %}
        <article>
          <div><b>{{ p.title }}</b><small>{{ p.city }} · {{ money(p) }}</small></div>
          <div><strong>{{ p.views }}</strong><small>vistas</small></div>
          <div><strong>{{ p.inquiryCount }}</strong><small>consultas</small></div>
          <div><strong>{{ p.visitCount }}</strong><small>visitas</small></div>
        </article>
        {% endfor %}
      </div>
    </div>
  </section>


  <section class="qc-admin-panel qc-change-review-panel" id="cambios">
    <div class="qc-panel-head">
      <div><h2>Cambios de publicaciones pendientes</h2><span>la versión actual sigue publicada hasta aprobar</span></div>
      <span>{{ attention.changeCount }} total</span>
    </div>

    {% if pendingChanges.length %}
      <div class="qc-change-review-list">
        {% for p in pendingChanges %}
        <article>
          <div>
            <small>{{ p.id }} · {{ p.ownerName }}</small>
            <b>{{ p.title }}</b>
            <span>Solicitud de modificación sobre una publicación activa.</span>
            {% if p.pendingChanges.price %}
              <em>Nuevo precio: {{ p.pendingChanges.currency or p.currency }} {{ p.pendingChanges.price | int }}</em>
            {% endif %}
          </div>

          <div class="qc-change-actions">
            <form method="post" action="/qcasa/admin/propiedades/{{ p.id }}/cambios/aprobar">
              <button class="qc-approve">Aprobar cambios</button>
            </form>

            <form method="post" action="/qcasa/admin/propiedades/{{ p.id }}/cambios/rechazar">
              <input name="reason" placeholder="Motivo si rechazás">
              <button class="qc-reject">Rechazar</button>
            </form>
          </div>
        </article>
        {% endfor %}
      </div>
    {% else %}
      <div class="qc-empty">No hay cambios de publicaciones pendientes.</div>
    {% endif %}
  </section>

  <section class="qc-admin-panel qc-review-panel" id="pendientes">
    <div class="qc-panel-head">
      <div><h2>Pendientes de aprobación</h2><span>vista rápida</span></div>
      <span>{{ attention.pendingCount }} total</span>
    </div>

    {% if pending.length %}
      <div class="qc-pending-compact">
        {% for p in pending %}
        <article>
          <img src="{{ p.image }}" alt="">
          <div>
            <small>{{ p.category }} · {{ p.operation }} · {{ p.ownerName }}</small>
            <b>{{ p.title }}</b>
            <span>{{ money(p) }} · {{ p.city }}</span>
          </div>
          <div class="qc-pending-actions">
            <form method="post" action="/qcasa/admin/propiedades/{{ p.id }}/aprobar">
              <button class="qc-approve">Aprobar</button>
            </form>
            <a href="/qcasa/admin/propiedades/{{ p.id }}/editar">Revisar</a>
          </div>
        </article>
        {% endfor %}
      </div>
    {% else %}
      <div class="qc-empty">No hay publicaciones pendientes.</div>
    {% endif %}
  </section>
</main>
{% endblock %}

{% extends 'layouts/main.njk' %}{% block content %}<section class="section"><span class="eyebrow">PROPIEDADES</span><h1>Propiedades conectadas a QCASA</h1><div class="property-cards">{% for p in properties %}<article><h3>{{ p.address }}</h3><p>Unidad: {{ p.unit }}</p><p>Código QR: <code>{{ p.code }}</code></p><a class="btn btn-light" href="/r/{{ p.code }}">Probar QR</a></article>{% endfor %}</div></section>{% endblock %}

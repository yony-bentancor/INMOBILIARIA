{% extends 'layouts/main.njk' %}
{% block content %}<div class="tenant-shell"><div class="tenant-brand"><img src="/img/logo-qcasa.svg"></div><section class="tenant-card"><span class="badge">Reclamo #{{ complaint.number or complaint.id }}</span><h1>{{ complaint.title or complaint.category }}</h1><p>{{ complaint.description }}</p><div class="status-box"><strong>Estado actual</strong><span class="status status-{{ (complaint.status or 'nuevo')|lower|replace(' ','-') }}">{{ complaint.status }}</span></div><p class="muted">Cuando un técnico acepte el trabajo, acá vas a ver sus datos y el horario estimado.</p></section></div>{% endblock %}

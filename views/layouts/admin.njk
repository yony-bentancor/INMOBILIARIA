<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#f2a000">
  <title>{{ title or 'Administrador | QCASA' }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body class="admin-role">
  <div class="admin-app">
    <aside class="admin-sidebar">
      <a href="/admin" class="admin-brand"><img src="/img/logo-qcasa.svg" alt="QCASA"></a>
      <span class="admin-label">OPERACIÓN</span>
      <nav>
        <a href="/admin">Panel</a>
        <a href="/admin#reclamos">Reclamos</a>
        <a href="/admin#propiedades">Propiedades</a>
        <a href="/admin#propietarios">Propietarios</a>
        <a href="/admin#inquilinos">Inquilinos</a>
        <a href="/admin#tecnicos">Técnicos</a>
        <a href="/admin#agenda">Agenda</a>
        <a href="/admin#notificaciones">Notificaciones</a>
        <a href="/admin#archivos">Archivos</a>
        <a href="/admin#configuracion">Configuración</a>
      </nav>
      <div class="admin-sidebar-bottom">
        <strong>{{ sessionUser.name }}</strong>
        <form method="post" action="/salir"><button class="btn btn-light">Cerrar sesión</button></form>
      </div>
    </aside>
    <main class="admin-content">{% block content %}{% endblock %}</main>
  </div>
  <script src="/js/app.js"></script>
</body>
</html>

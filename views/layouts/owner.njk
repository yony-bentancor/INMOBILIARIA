<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#f2a000">
  <title>{{ title or 'Propietario | QCASA' }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body class="role-body owner-role">
  <header class="role-header">
    <a href="/propietario" class="role-brand"><img src="/img/logo-qcasa.svg" alt="QCASA"></a>
    <nav class="role-nav">
      <a href="/propietario">Inicio</a>
      <a href="/propietario#propiedades">Mis propiedades</a>
      <a href="/propietario#reclamos">Reclamos</a>
      <a href="/propietario#notificaciones">Notificaciones</a>
      <a href="/propietario#documentos">Documentos</a>
    </nav>
    <div class="role-account">
      <span>{{ sessionUser.name }}</span>
      <form method="post" action="/salir"><button class="btn btn-ghost">Salir</button></form>
    </div>
  </header>

  <main>{% block content %}{% endblock %}</main>
  <script src="/js/app.js"></script>
</body>
</html>

<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#f2a000">
  <title>{{ title or 'QCASA' }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  {% block head %}{% endblock %}
</head>
<body class="role-body tenant-role">
  <header class="role-header tenant-header">
    <a href="/" class="role-brand"><img src="/img/logo-qcasa.svg" alt="QCASA"></a>
    <nav class="role-nav">
      <a href="/qr">Escanear QR</a>
      <a href="/mis-reclamos">Mis reclamos</a>
      <a href="/emergencia">Emergencia</a>
    </nav>
  </header>

  <main>{% block content %}{% endblock %}</main>

  <footer class="role-footer">
    <span>QCASA · Escaneá. Reportá. Nosotros nos ocupamos.</span>
    <a href="/">Conocer QCASA</a>
  </footer>
  <script src="/js/app.js"></script>
  {% block scripts %}{% endblock %}
</body>
</html>
